<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

  <!--
    L.A.I.T.H. tuning knobs. Edit `Personal Assistant.exe.config` next to the exe
    and restart the app — no rebuild, and none of the `setx` / Visual-Studio
    environment-snapshot trouble that made these look broken when they were
    environment variables.

    Each also accepts an environment-variable override (LiveVoice -> LAITH_LIVE_VOICE)
    for one-off experiments; the env var WINS, and the `[config]` line printed at
    startup shows which source each value actually came from.

    Secrets are NOT here — GEMINIAPI_KEY, SPEECH_KEY, SPEECH_REGION and
    CONTACTS_PATH stay in the environment.
  -->
  <appSettings>

    <!-- Gemini Live model. gemini-2.5-flash-native-audio-* has Google Search
         grounding on this project; the gemini-3.x Live models do NOT (0/0 RPD),
         though their ASR can be pinned with LiveLanguage. Grounding was judged
         the more valuable half of that trade. -->
    <add key="LiveModel" value="gemini-2.5-flash-native-audio-preview-12-2025" />

    <!-- One of the 30 Gemini prebuilt voices. Changing this needs a re-run of
         `Personal Assistant.exe` with the render-clips switch, or the greeting,
         goodbye and timer announcements stay in the old voice. -->
    <add key="LiveVoice" value="Iapetus" />

    <!-- BCP-47 code for the input ASR. Native-audio models ignore it (accepted,
         no effect); only the half-cascade gemini-3.x Live models honour it.
         Empty = let the model choose. -->
    <add key="LiveLanguage" value="" />

    <!-- true: the server decides where your turns end (better — it stopped
         sentences being cut in half at pauses). false: the local energy gate
         does, using LiveHangoverMs. Server VAD is unproven against a mistuned
         echo tail; if the assistant starts interrupting itself on speakers,
         set this false. -->
    <add key="LiveServerVad" value="true" />

    <!-- Only used when LiveServerVad is false. How long the mic gate stays open
         after you stop making noise, which doubles as the end of your turn.
         Too low cuts sentences in half at a pause; every millisecond is added
         latency before every reply. -->
    <add key="LiveHangoverMs" value="1200" />

    <!-- RMS level above which mic audio is worth uploading. 0 = derive it from
         the room's noise floor, which is almost always right. -->
    <add key="LiveUploadFloor" value="0" />

    <!-- Mic input gain. 0 = adapt automatically (recommended), 1 = off, anything
         else = a fixed multiplier.

         Leaning back from the mic drops the level ~13 dB, and that alone is
         enough to turn a clean transcript into nonsense — native-audio Gemini
         does ASR and reasoning in one pass, so the signal we send is the only
         lever there is. Adaptive mode normalises speech toward LiveInputTarget
         and holds its gain through silence, so it never amplifies room tone.
         Check the `gain=` and `out=` fields on the utterance line. -->
    <add key="LiveInputGain" value="0" />

    <!-- Target mean level for adaptive gain, measured from utterances that
         transcribed correctly on this mic. Raise it if quiet speech is still
         being misheard; lower it if loud speech starts sounding clipped. -->
    <add key="LiveInputTarget" value="0.05" />

    <!-- Session watchdog. The hard cap is the backstop against a stuck socket;
         the idle window is how long silence lasts before the conversation ends
         on its own. -->
    <add key="LiveHardCapSeconds" value="600" />
    <add key="LiveIdleSeconds" value="12" />

    <!-- How long a single tool may run before the session gives up and replies
         without it. The microphone is gated shut for the whole time, so this is
         also the longest the user can go unable to speak.

         Sized off turn_on_playstation, which is the slow one — not the Phone
         Link SMS automation this used to name. It waits up to 30s for the Remote
         Play window, then 6s for the console's stream to settle, then drives the
         navigation: over 36s before it can possibly return. At the old 30s a
         successful launch reported "timed out" to the model, which then told the
         user it had failed while the game was loading. -->
    <add key="LiveToolTimeoutSeconds" value="60" />

    <!-- Google Search grounding. Empty = decide per model, which is what you
         want: on for 2.5, off for gemini-3.x, because asking for grounding a
         model has no allowance for fails the WHOLE request rather than
         degrading it. true/false force it either way. -->
    <add key="Grounding" value="" />

    <!-- How far back a conversation is still "the conversation" after a
         restart. Long enough to survive closing the app mid-thought or a lunch
         break; short enough that this morning isn't treated as this moment,
         which would have "turn it back off" resolving against a light you
         switched on hours ago. 0 disables persistence and forgets on exit,
         which is how it behaved before. Stored in
         %APPDATA%\LAITH\conversation.json. -->
    <add key="ConversationMemoryHours" value="2" />

    <!-- ===== Suggestions: the assistant speaking first ===== -->

    <!-- How talkative L.A.I.T.H. is allowed to be on its own initiative — it
         notices something and OFFERS ("it's 1am and Fajr is at 5:10, want an
         alarm?"), which you answer yes or no to.

           off     nothing is ever volunteered
           rare    at most 3 a day, and never within 4 hours of the last
           normal  at most 8 a day, 90 minutes apart          (default)
           chatty  at most 20 a day, 30 minutes apart

         Start at normal. Move to rare if it gets irritating, chatty if you
         want it to actually surface what it can do. Suggestions always respect
         quiet hours and are never made to an empty desk. -->
    <add key="Suggestions" value="normal" />

    <!-- Override the level's pacing directly. 0 means "use whatever the level
         above implies". These are independent on purpose: the gap stops a
         burst, the daily cap stops a drip, and they fail in different ways. -->
    <add key="SuggestionMinGapMinutes" value="0" />
    <add key="SuggestionsPerDay" value="0" />

    <!-- ===== Picking up after a restart ===== -->

    <!-- Timers, alarms, standing rules and event watches all survive a shutdown.
         How they survive depends on what they are:

           a plain timer ("ten minutes")     PAUSES, and resumes with whatever
                                             was left when the PC went off
           an alarm ("wake me at 7")         keeps its moment; 7am is 7am
           an event timer (event_subject)    keeps its deadline AND gets checked

         How late something may be and still be mentioned when the assistant
         comes back. A ten-minute timer that elapsed at 3am is noise by
         breakfast; the longer the original wait, the longer it stays news, so
         an event timer gets a quarter of its own countdown on top of this (up
         to a day). Anything tied to a real event ignores this entirely — the
         watch below decides when to give up on those. 0 disables catch-up. -->
    <add key="ReminderCatchUpMinutes" value="60" />

    <!-- Whether an event actually happened is checked with Google Search
         grounding, which the dispatch model (gemini-3.1-flash-lite) does NOT
         have on this project — an unsearched answer here would just be the
         model's training data read out as a fact-check, so this call gets its
         own grounding-capable model. Note that gemini-2.5-flash is the one
         model the free tier rations tightly (20/day), which is what the cap
         below is protecting. -->
    <add key="EventVerifyModel" value="gemini-2.5-flash" />

    <!-- Most grounded checks per day, across every watch. Backoff means one
         watch normally costs a handful of checks over its life (1h, 2h, 4h, 8h,
         then twelve-hourly), but this is the hard stop that keeps a watch from
         quietly eating the day's quota in the background. -->
    <add key="EventVerifyChecksPerDay" value="12" />

    <!-- How long a watch keeps asking before it gives up and says so. Something
         that hasn't shipped two weeks after you expected it has slipped, not
         been delayed by an hour. -->
    <add key="EventWatchAbandonDays" value="14" />

    <!-- ===== Proactive announcements ===== -->

    <!-- Announce each prayer shortly before it arrives, without being asked.
         Calculated locally from your location — no API call, no LLM turn. -->
    <add key="PrayerAnnouncements" value="true" />

    <!-- How many minutes ahead of each prayer to speak. 0 announces at the
         time itself. Changing this changes the words spoken, so re-run
         `Personal Assistant.exe` with the render-clips switch afterwards, or
         the announcements come back in the old Azure voice. -->
    <add key="PrayerLeadMinutes" value="10" />

    <!-- Any single prayer can override that: FajrLeadMinutes, DhuhrLeadMinutes,
         JumuahLeadMinutes, AsrLeadMinutes, MaghribLeadMinutes, IshaLeadMinutes.
         Jumuah defaults to 30 even with no key here, because ten minutes is the
         right notice for a prayer you do where you are and the wrong notice for
         one you travel to. -->
    <add key="JumuahLeadMinutes" value="30" />

    <!-- Nothing unprompted is said after this long without keyboard or mouse
         input: an assistant talking to an empty room is the reason people turn
         proactive features off. Announcements held this way keep retrying for
         their own grace window, then give up. -->
    <add key="PresenceIdleMinutes" value="15" />

    <!-- Quiet hours, HH:mm, wrapping midnight. Applies to unprompted
         announcements only — never to a reply you asked for, and never to
         prayer times, which are exempt because Fajr and Isha sit inside any
         sane quiet window and suppressing them would defeat the point. Set
         both to the same value to disable. -->
    <add key="QuietHoursStart" value="23:00" />
    <add key="QuietHoursEnd" value="07:00" />

    <!-- ===== Logging =====

         The app is a WinExe, so it has NO console and every Console.WriteLine
         goes nowhere unless something captures it. Until 2026-08-23 the only
         way to see anything was to launch it with the shell redirecting
         stdout, which failed three ways in one night: forgotten (a whole
         screened call with no record), locked by a stale cmd window (the app
         would not start), and tied to how it happened to be launched rather
         than to the app. A feature that runs while nobody is there cannot
         have its only record depend on that.

         One file per RUN, newest few kept. Written UTF-8 and flushed on
         every line, because what these get read for is HANGS: the process is
         still alive and the last line before the stall is the whole answer. -->
    <add key="LogToFile" value="true" />

    <!-- Empty means %APPDATA%\LAITH\logs. -->
    <add key="LogDir" value="" />

    <!-- How many past runs to keep before the oldest are deleted. -->
    <add key="LogKeepRuns" value="20" />

  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
