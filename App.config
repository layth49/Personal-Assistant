<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <!-- Tuning knobs, read by LaithConfig. An environment variable of the same
       name with a LAITH_ prefix (LAITH_SUGGESTIONS, LAITH_QUIET_HOURS_START)
       wins over anything here, and the startup [config] line prints which one
       actually took effect. -->
  <appSettings>

    <!-- How far back a conversation is still "the conversation" after a
         restart. Long enough to survive closing the app mid-thought; short
         enough that this morning isn't treated as this moment. 0 disables
         persistence, which is how it behaved before. Stored in
         %APPDATA%\LAITH\conversation.json. -->
    <add key="ConversationMemoryHours" value="2" />

    <!-- ===== Suggestions: the assistant speaking first ===== -->

    <!-- It notices something and OFFERS ("it's 1am and Fajr is at 5:10, want an
         alarm?"), which you answer yes or no to.

           off     nothing is ever volunteered
           rare    at most 3 a day, and never within 4 hours of the last
           normal  at most 8 a day, 90 minutes apart          (default)
           chatty  at most 20 a day, 30 minutes apart

         You can also just say "stop suggesting things" or "speak up more" —
         that takes effect immediately and lasts until the app restarts. -->
    <add key="Suggestions" value="normal" />

    <!-- Override the level's pacing directly. 0 means "use the level above".
         Independent on purpose: the gap stops a burst, the cap stops a drip. -->
    <add key="SuggestionMinGapMinutes" value="0" />
    <add key="SuggestionsPerDay" value="0" />

    <!-- ===== Picking up after a restart ===== -->

    <!-- Timers, alarms, standing rules and event watches all survive a shutdown.
         How they survive depends on what they are:

           a plain timer ("ten minutes")     PAUSES, and resumes with whatever
                                             was left when the PC went off
           an alarm ("wake me at 7")         keeps its moment; 7am is 7am
           an event timer (event_subject)    keeps its deadline AND gets checked

         How late something may be and still be mentioned when the assistant
         comes back. A ten-minute timer that elapsed at 3am is noise by
         breakfast; the longer the original wait, the longer it stays news, so
         an event timer gets a quarter of its own countdown on top of this (up
         to a day). Anything tied to a real event ignores this entirely — the
         watch below decides when to give up on those. 0 disables catch-up. -->
    <add key="ReminderCatchUpMinutes" value="60" />

    <!-- Whether an event actually happened is decided from a SearxNG search,
         not from the model's own knowledge: LocalLLMService.VerifyEventAsync
         searches first and REFUSES to answer if nothing comes back. That is the
         local stand-in for the Google-search grounding main gets from Gemini,
         and the refusal is the important half — training data is older than the
         results and release dates move.

         Nothing here is metered, so unlike main this cap is not protecting a
         quota. It is protecting the one local model: a check occupies LM Studio
         for seconds, and while it does the assistant cannot answer anything.
         SearxNG must be up (docker compose up -d searxng) or every check comes
         back "no search results" and the watch just keeps waiting. -->
    <add key="EventVerifyChecksPerDay" value="48" />

    <!-- How long a watch keeps asking before it gives up and says so. Something
         that hasn't shipped two weeks after you expected it has slipped, not
         been delayed by an hour. -->
    <add key="EventWatchAbandonDays" value="14" />

    <!-- ===== Proactive announcements ===== -->

    <!-- Announce each prayer shortly before it arrives, without being asked.
         Calculated locally from your location - no API call, no LLM turn. -->
    <add key="PrayerAnnouncements" value="true" />

    <!-- How many minutes ahead of each prayer to speak. 0 announces at the
         time itself. -->
    <add key="PrayerLeadMinutes" value="10" />

    <!-- Any single prayer can override that: FajrLeadMinutes, JumuahLeadMinutes
         and so on. Jumuah defaults to 30 even with no key here, because ten
         minutes is the right notice for a prayer you do where you are and the
         wrong notice for one you travel to. -->
    <add key="JumuahLeadMinutes" value="30" />

    <!-- Nothing unprompted is said after this long without keyboard or mouse
         input: an assistant talking to an empty room is the reason people turn
         proactive features off. -->
    <add key="PresenceIdleMinutes" value="15" />

    <!-- Quiet hours, HH:mm, wrapping midnight. Applies to unprompted
         announcements only - never to a reply you asked for, and never to
         prayer times, which are exempt. Set both the same to disable. -->
    <add key="QuietHoursStart" value="23:00" />
    <add key="QuietHoursEnd" value="07:00" />

    <!-- ===== Logging =====

         The app is a WinExe, so it has NO console and every Console.WriteLine
         goes nowhere unless something captures it. Until 2026-08-23 the only
         way to see anything was to launch it with the shell redirecting
         stdout, which failed three ways in one night: forgotten (a whole
         screened call with no record), locked by a stale cmd window (the app
         would not start), and tied to how it happened to be launched rather
         than to the app. A feature that runs while nobody is there cannot
         have its only record depend on that.

         On this branch the stakes are higher still, because the STT server,
         the router and Kokoro are three more processes that can fail on
         their own, and their failures only ever show up in these lines.

         One file per RUN, newest few kept. Written UTF-8 and flushed on
         every line, because what these get read for is HANGS: the process is
         still alive and the last line before the stall is the whole answer. -->
    <add key="LogToFile" value="true" />

    <!-- Empty means %APPDATA%\LAITH\logs. -->
    <add key="LogDir" value="" />

    <!-- How many past runs to keep before the oldest are deleted. -->
    <add key="LogKeepRuns" value="20" />

    <!-- Where voice-written notes live, as plain .md files. Local on purpose:
         Documents is OneDrive-redirected on this machine. -->
    <add key="NotesDir" value="C:\Users\layth\Notes" />

    <!-- ===== Seeing the screen =====

         look_at_screen and copy_from_screen send a screenshot to a VISION
         model in LM Studio. That is a DIFFERENT model from the router, and
         those calls are the only ones this app makes that name a model at all
         — every other request omits `model`, so LM Studio answers with
         whatever happens to be loaded.

         THE VRAM BUDGET IS TIGHT. This box has about 6 GB, which is the same
         reason a true speech-to-speech model was ruled out for this branch. A
         vision model loaded alongside the 4B router competes for it, and LM
         Studio may EVICT one to load the other — so the first "what does this
         say" in a while is slow, and so is the first spoken answer after it,
         while the router loads back. Nothing is broken when that happens; it
         is the standing cost of a second model.

         Whatever is set here must MATCH a model LM Studio actually has, id and
         all. A wrong id comes back 404 and the assistant says so out loud,
         naming the id it tried. `lms ls` prints the real ones.

         And the usual trap applies to all three of these: an environment
         variable of the same name with a LAITH_ prefix
         (LAITH_LOCAL_VISION_MODEL, LAITH_LOCAL_VISION_MAX_DIMENSION,
         LAITH_LOCAL_VISION_TIMEOUT_SECONDS) BEATS anything written here, and a
         stale one in HKCU:\Environment has silently run this app on the wrong
         model for weeks. The startup [config] line prints what actually took
         effect and marks each value "(env)" or "(config)" — read that line
         first when a vision tool behaves oddly, before suspecting any code. -->
    <add key="LocalVisionModel" value="qwen/qwen3-vl-4b" />

    <!-- Longest edge, in pixels, a screenshot may reach before it is resampled
         down (aspect ratio preserved). Image tokens scale with AREA, so a 4K
         capture is several times the prompt of a 1080p one, and on 6 GB the
         failure mode isn't "slower", it's the request being refused.

         1920 is chosen so the common case is the IDENTITY transform: a 1080p
         monitor passes through with no resampling at all. That matters because
         copy_from_screen exists to return text VERBATIM, and downscaling is
         precisely what destroys small text — the cap must not be able to
         corrupt the one tool whose whole contract is that it doesn't. Two
         cases do get resampled: a 4K screen, and monitor:"all" across two
         screens side by side. Raise this if extraction starts dropping
         characters; lower it if the vision model won't fit. -->
    <add key="LocalVisionMaxDimension" value="1920" />

    <!-- How long to wait for the vision model, in seconds. Generous, because a
         cold just-in-time load has to page both the weights and the vision
         tower in and a screenshot is a much larger prompt than a spoken turn.
         Bounded, because the microphone is held open for the whole turn and
         dead air is worse than a spoken "it's still loading, try again". -->
    <add key="LocalVisionTimeoutSeconds" value="180" />

  </appSettings>
  <runtime>
