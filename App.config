<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

  <!--
    L.A.I.T.H. tuning knobs. Edit `Personal Assistant.exe.config` next to the exe
    and restart the app — no rebuild, and none of the `setx` / Visual-Studio
    environment-snapshot trouble that made these look broken when they were
    environment variables.

    Each also accepts an environment-variable override (LiveVoice -> LAITH_LIVE_VOICE)
    for one-off experiments; the env var WINS, and the `[config]` line printed at
    startup shows which source each value actually came from.

    Secrets are NOT here — GEMINIAPI_KEY, SPEECH_KEY, SPEECH_REGION and
    CONTACTS_PATH stay in the environment.
  -->
  <appSettings>

    <!-- Gemini Live model. gemini-2.5-flash-native-audio-* has Google Search
         grounding on this project; the gemini-3.x Live models do NOT (0/0 RPD),
         though their ASR can be pinned with LiveLanguage. Grounding was judged
         the more valuable half of that trade. -->
    <add key="LiveModel" value="gemini-2.5-flash-native-audio-preview-12-2025" />

    <!-- One of the 30 Gemini prebuilt voices. Changing this needs a re-run of
         `Personal Assistant.exe` with the render-clips switch, or the greeting,
         goodbye and timer announcements stay in the old voice. -->
    <add key="LiveVoice" value="Iapetus" />

    <!-- BCP-47 code for the input ASR. Native-audio models ignore it (accepted,
         no effect); only the half-cascade gemini-3.x Live models honour it.
         Empty = let the model choose. -->
    <add key="LiveLanguage" value="" />

    <!-- true: the server decides where your turns end (better — it stopped
         sentences being cut in half at pauses). false: the local energy gate
         does, using LiveHangoverMs. Server VAD is unproven against a mistuned
         echo tail; if the assistant starts interrupting itself on speakers,
         set this false. -->
    <add key="LiveServerVad" value="true" />

    <!-- Only used when LiveServerVad is false. How long the mic gate stays open
         after you stop making noise, which doubles as the end of your turn.
         Too low cuts sentences in half at a pause; every millisecond is added
         latency before every reply. -->
    <add key="LiveHangoverMs" value="1200" />

    <!-- RMS level above which mic audio is worth uploading. 0 = derive it from
         the room's noise floor, which is almost always right. -->
    <add key="LiveUploadFloor" value="0" />

    <!-- Mic input gain. 0 = adapt automatically (recommended), 1 = off, anything
         else = a fixed multiplier.

         Leaning back from the mic drops the level ~13 dB, and that alone is
         enough to turn a clean transcript into nonsense — native-audio Gemini
         does ASR and reasoning in one pass, so the signal we send is the only
         lever there is. Adaptive mode normalises speech toward LiveInputTarget
         and holds its gain through silence, so it never amplifies room tone.
         Check the `gain=` and `out=` fields on the utterance line. -->
    <add key="LiveInputGain" value="0" />

    <!-- Target mean level for adaptive gain, measured from utterances that
         transcribed correctly on this mic. Raise it if quiet speech is still
         being misheard; lower it if loud speech starts sounding clipped. -->
    <add key="LiveInputTarget" value="0.05" />

    <!-- Session watchdog. The hard cap is the backstop against a stuck socket;
         the idle window is how long silence lasts before the conversation ends
         on its own. -->
    <add key="LiveHardCapSeconds" value="600" />
    <add key="LiveIdleSeconds" value="12" />

    <!-- How long a single tool may run before the session gives up and replies
         without it. The microphone is gated shut for the whole time, so this is
         also the longest the user can go unable to speak.

         Sized off turn_on_playstation, which is the slow one — not the Phone
         Link SMS automation this used to name. It waits up to 30s for the Remote
         Play window, then 6s for the console's stream to settle, then drives the
         navigation: over 36s before it can possibly return. At the old 30s a
         successful launch reported "timed out" to the model, which then told the
         user it had failed while the game was loading. -->
    <add key="LiveToolTimeoutSeconds" value="60" />

    <!-- Google Search grounding. Empty = decide per model, which is what you
         want: on for 2.5, off for gemini-3.x, because asking for grounding a
         model has no allowance for fails the WHOLE request rather than
         degrading it. true/false force it either way. -->
    <add key="Grounding" value="" />

    <!-- How far back a conversation is still "the conversation" after a
         restart. Long enough to survive closing the app mid-thought or a lunch
         break; short enough that this morning isn't treated as this moment,
         which would have "turn it back off" resolving against a light you
         switched on hours ago. 0 disables persistence and forgets on exit,
         which is how it behaved before. Stored in
         %APPDATA%\LAITH\conversation.json. -->
    <add key="ConversationMemoryHours" value="2" />

    <!-- ===== Suggestions: the assistant speaking first ===== -->

    <!-- How talkative L.A.I.T.H. is allowed to be on its own initiative — it
         notices something and OFFERS ("it's 1am and Fajr is at 5:10, want an
         alarm?"), which you answer yes or no to.

           off     nothing is ever volunteered
           rare    at most 3 a day, and never within 4 hours of the last
           normal  at most 8 a day, 90 minutes apart          (default)
           chatty  at most 20 a day, 30 minutes apart

         Start at normal. Move to rare if it gets irritating, chatty if you
         want it to actually surface what it can do. Suggestions always respect
         quiet hours and are never made to an empty desk. -->
    <add key="Suggestions" value="normal" />

    <!-- Override the level's pacing directly. 0 means "use whatever the level
         above implies". These are independent on purpose: the gap stops a
         burst, the daily cap stops a drip, and they fail in different ways. -->
    <add key="SuggestionMinGapMinutes" value="0" />
    <add key="SuggestionsPerDay" value="0" />

    <!-- ===== Picking up after a restart ===== -->

    <!-- Timers, alarms, standing rules and event watches all survive a shutdown.
         How they survive depends on what they are:

           a plain timer ("ten minutes")     PAUSES, and resumes with whatever
                                             was left when the PC went off
           an alarm ("wake me at 7")         keeps its moment; 7am is 7am
           an event timer (event_subject)    keeps its deadline AND gets checked

         How late something may be and still be mentioned when the assistant
         comes back. A ten-minute timer that elapsed at 3am is noise by
         breakfast; the longer the original wait, the longer it stays news, so
         an event timer gets a quarter of its own countdown on top of this (up
         to a day). Anything tied to a real event ignores this entirely — the
         watch below decides when to give up on those. 0 disables catch-up. -->
    <add key="ReminderCatchUpMinutes" value="60" />

    <!-- Whether an event actually happened is checked with Google Search
         grounding, which the dispatch model (gemini-3.1-flash-lite) does NOT
         have on this project — an unsearched answer here would just be the
         model's training data read out as a fact-check, so this call gets its
         own grounding-capable model. Note that gemini-2.5-flash is the one
         model the free tier rations tightly (20/day), which is what the cap
         below is protecting. -->
    <add key="EventVerifyModel" value="gemini-2.5-flash" />

    <!-- Most grounded checks per day, across every watch. Backoff means one
         watch normally costs a handful of checks over its life (1h, 2h, 4h, 8h,
         then twelve-hourly), but this is the hard stop that keeps a watch from
         quietly eating the day's quota in the background. -->
    <add key="EventVerifyChecksPerDay" value="12" />

    <!-- How long a watch keeps asking before it gives up and says so. Something
         that hasn't shipped two weeks after you expected it has slipped, not
         been delayed by an hour. -->
    <add key="EventWatchAbandonDays" value="14" />

    <!-- ===== Proactive announcements ===== -->

    <!-- Announce each prayer shortly before it arrives, without being asked.
         Calculated locally from your location — no API call, no LLM turn. -->
    <add key="PrayerAnnouncements" value="true" />

    <!-- How many minutes ahead of each prayer to speak. 0 announces at the
         time itself. Changing this changes the words spoken, so re-run
         `Personal Assistant.exe` with the render-clips switch afterwards, or
         the announcements come back in the old Azure voice. -->
    <add key="PrayerLeadMinutes" value="10" />

    <!-- Any single prayer can override that: FajrLeadMinutes, DhuhrLeadMinutes,
         JumuahLeadMinutes, AsrLeadMinutes, MaghribLeadMinutes, IshaLeadMinutes.
         Jumuah defaults to 30 even with no key here, because ten minutes is the
         right notice for a prayer you do where you are and the wrong notice for
         one you travel to. -->
    <add key="JumuahLeadMinutes" value="30" />

    <!-- Nothing unprompted is said after this long without keyboard or mouse
         input: an assistant talking to an empty room is the reason people turn
         proactive features off. Announcements held this way keep retrying for
         their own grace window, then give up. -->
    <add key="PresenceIdleMinutes" value="15" />

    <!-- Quiet hours, HH:mm, wrapping midnight. Applies to unprompted
         announcements only — never to a reply you asked for, and never to
         prayer times, which are exempt because Fajr and Isha sit inside any
         sane quiet window and suppressing them would defeat the point. Set
         both to the same value to disable. -->
    <add key="QuietHoursStart" value="23:00" />
    <add key="QuietHoursEnd" value="07:00" />

    <!-- ===== Call screening ===== -->

    <!-- Master switch. Off means the ring watcher is never even constructed, and
         the screen_calls / end_call tools are not offered to the model. Turning
         it on does NOT start answering calls: screening only ever answers inside
         an armed window Layth asked for out loud, and the arm expires. -->
    <add key="CallScreening" value="true" />

    <!-- How long "screen my calls" lasts before it turns itself off. An arm that
         outlives the reason for it is how an assistant ends up answering a call
         you were sitting next to. -->
    <add key="CallScreeningArmMinutes" value="30" />

    <!-- Whether screening is ON by default rather than needing to be armed out
         loud. Empty follows the TRANSPORT, which is the honest answer:

           phonelink   -> off by default. It answers a handset ringing in your
                          hand, and an assistant that silently picks that up
                          whenever the app is running is a much worse product.

           googlevoice -> ON by default. A call only reaches that number because
                          the carrier already forwarded it after you did not
                          answer, so the choice is never "the assistant or you",
                          it is "the assistant or voicemail". And the old model
                          required SPEAKING to the machine to open a 30-minute
                          window, while the whole point is calls arriving when you
                          are out - so the window was shut exactly when it
                          mattered.

         true / false force it either way. -->
    <add key="CallScreeningAlwaysArmed" value="" />

    <!-- How long "stop screening my calls" pauses it for, in always-armed mode,
         before it comes back on by itself. It resumes deliberately: a pause you
         forget would kill the feature silently, and you would only discover it by
         missing a screened call while out. -->
    <add key="CallScreeningPauseMinutes" value="120" />

    <!-- WHERE A MESSAGE A SCREENED CALL TOOK GETS SENT.
         Layth's own mobile, texted through the Google Voice web client the
         moment the call ends — over the internet, to the phone he is carrying.
         That is the whole point: a message that only reaches the machine he
         walked away from is barely better than a missed call.

         Any format works; only the digits are kept. EMPTY DISABLES TEXTING, and
         the message is then only spoken when he gets back.

         Verified 2026-08-23 that Google Voice will text this number even though
         the mobile is UNLINKED from the account — the unlink is what makes
         forwarded calls ring the browser, so it was worth checking that it did
         not also break the texting. It does not. -->
    <add key="CallNotifyNumber" value="5048810943" />

    <!-- How long an undelivered message stays worth SAYING OUT LOUD. Past this it
         stays in the call log for `list_calls` and is never announced.

         It is a staleness rule, not an optimisation: "the car is ready, collect
         before 6" is worth interrupting someone for on the day and is noise the
         next morning, and being read six of them at once is how a useful feature
         earns itself a "stop doing that". -->
    <add key="CallMessageSpeakWithinHours" value="12" />

    <!-- How long the SPOKEN channel holds off, giving the text a chance to win.
         The text takes ten to fifteen seconds to drive the browser; without a
         head start, a message taken while Layth is at his desk gets spoken on
         the next one-second tick and the text lands anyway — both channels, same
         message. Zero disables the head start. -->
    <add key="CallMessageSpokenDelaySeconds" value="60" />

    <!-- THE GREETING A KNOWN CALLER HEARS, with {name} where their first name
         goes. A fixed recording is indistinguishable from an answering machine,
         so callers talk past it or hang up; hearing their own name says both
         "this is live" and "it knows who you are".

         It CANNOT be rendered during the call — a render takes the better part
         of ten seconds and the greeting is what covers the Live connect
         handshake — so these are pre-rendered into the voice clip cache.
         the `render-clips` switch does one per contact up front, and a call from a name
         with no clip renders one afterwards, so the second call from anyone is
         greeted properly. A caller with no usable name (an unrecognised number,
         a caller ID that arrived as digits) falls back to CallGreetingWav below.

         Clips are keyed by voice AND text, so CHANGING THIS WORDING INVALIDATES
         EVERY CACHED GREETING — re-run the `render-clips` switch afterwards, exactly as you
         would after changing the voice. Until you do, callers get the stock WAV.

         Keep it consistent with whatever greeting.wav says. -->
    <add key="CallGreetingNamed" value="Hi {name}, you've reached Layth's assistant. He can't get to the phone right now, but I can take a message." />

    <!-- The WAV played to a screened caller, DOWN THE PHONE LINE — it is written
         to CallCableOut below, not to the speakers. Relative paths are resolved
         next to the exe; empty means `callscreening\greeting.wav` there.
         Screening REFUSES TO ARM when this file is missing, and says so —
         answering with nothing to play is a caller listening to silence.

         It is still a fixed recording rather than the model's first words,
         because it covers the Live session's connect handshake the same way the
         wake greeting covers it in an ordinary conversation. The model is told
         the caller has already been greeted and waits for them to speak. -->
    <add key="CallGreetingWav" value="" />

    <!-- Hard cap on a WHOLE screened call — greeting and conversation together.
         A stranger on the line is the one thing in this app that should never be
         open-ended, so this is a hang-up, not a warning. -->
    <add key="CallMaxSeconds" value="180" />

    <!-- Who the assistant says it is.

           assistant  announces itself as Layth's assistant taking a message
           as_me      speaks in the first person as him

         `assistant` is the default deliberately. A caller who hears Layth's
         voice may reasonably act on what it says, and several US states require
         notice before an automated system records a call — which this does, as
         it keeps a transcript. `as_me` stays available and is a choice somebody
         makes on purpose. Anything else falls back to `assistant` and says so. -->
    <add key="CallPersona" value="assistant" />

    <!-- The Live model a call runs on, and the voice it uses. Empty means
         whatever LiveModel / LiveVoice above say, which is the point: there is
         no second model to keep working here.

         The plan originally called for pinning a half-cascade model in TEXT
         mode. That is dead — measured 2026-08-15, NO Live model on this key
         serves responseModalities:["TEXT"]; all four general-purpose ones refuse
         at setup. The native-audio model's outputAudioTranscription carries the
         same words and arrives ~340ms AHEAD of its own audio, so Phase 3b's
         cloned voice can be driven from that instead. Do not retry the swap. -->
    <add key="CallModel" value="" />
    <add key="CallVoice" value="" />

    <!-- Drop a Bluetooth headset while the phone is still RINGING, rather than
         after answering.

         Route B (answer on the handset, drop the headset, transfer to the PC)
         works, but costs the caller ~9s of silence on a call they have already
         been connected to — the disconnect alone is ~7.3s and does not reduce.
         Three extra rings is a normal experience; being answered and met with
         nothing is not.

         The plan rejected this because of the ~20s ring deadline, which was
         written before the disconnect had been measured. It needs no new routing
         logic: Answer() reads the toast's first button by name, so if Phone Link
         re-renders the toast once the headset is gone it simply finds
         `Accept on PC` and route B never happens. If it does not re-render,
         route B runs as before with the disconnect already paid for.

         false answers first and disconnects afterwards, as it did before. -->
    <add key="CallDropHeadsetWhileRinging" value="true" />

    <!-- Silence pushed down the cable before the greeting's first word.

         Measured on a real call: the caller reliably heard the last two thirds
         of a 5.4s greeting and never the start. The audio is written the moment
         the bridge reports itself up, but the path is not carrying yet —
         WasapiOut has been told to play rather than observed playing, and on
         route B the HFP link has only just been transferred to the PC. Silence
         is the only thing that can be lost harmlessly, so it goes first. -->
    <add key="CallGreetingLeadInMs" value="2000" />

    <!-- Reasoning tokens the model may spend per turn on a call. 0 removes them
         entirely, which is measured to save ~330ms before every reply — worth
         having on a phone call. -1 leaves the model's own default.

         Raise it if the assistant starts answering from reflex: with no
         deliberation it is more prone to falling into a canned line and never
         calling a tool. That happened on the first real conversation, but the
         cause was the system instruction rather than this (see CallPersona), so
         fix the words first and reach for this second. -->
    <add key="CallThinkingBudget" value="0" />

    <!-- How long a screened call may go completely silent before the assistant
         asks whether the caller is still there. If the silence continues past a
         second window, the line is treated as dead and hung up — somebody who
         dialled and then walked away should not hold the line to the cap. -->
    <add key="CallSilenceSeconds" value="15" />

    <!-- ===== Logging =====

         The app is a WinExe, so it has NO console and every Console.WriteLine
         goes nowhere unless something captures it. Until 2026-08-23 the only
         way to see anything was to launch it with the shell redirecting
         stdout, which failed three ways in one night: forgotten (a whole
         screened call with no record), locked by a stale cmd window (the app
         would not start), and tied to how it happened to be launched rather
         than to the app. A feature that runs while nobody is there cannot
         have its only record depend on that.

         One file per RUN, newest few kept. Written UTF-8 and flushed on
         every line, because what these get read for is HANGS: the process is
         still alive and the last line before the stall is the whole answer. -->
    <add key="LogToFile" value="true" />

    <!-- Empty means %APPDATA%\LAITH\logs. -->
    <add key="LogDir" value="" />

    <!-- How many past runs to keep before the oldest are deleted. -->
    <add key="LogKeepRuns" value="20" />

    <!-- ===== Google Voice transport =====

         Phone Link can only reach this PC over Bluetooth, so screening used to
         work only while the phone was within about ten metres of the desk —
         which is exactly when Layth could have answered it himself. A Google
         Voice number rings in a BROWSER instead, so the phone can be anywhere.

         Carrier side this needs unconditional forwarding from the real number
         (Verizon: *72 to turn on, *73 off) and — measured 2026-08-21, this is
         the part that is not obvious — the mobile UNLINKED from the Google
         Voice account. Google sends calls forwarded from a LINKED number
         straight to voicemail by design, as its documented way of replacing
         carrier voicemail, and no amount of settings fixes that while the link
         exists.

         `phonelink` stays the default. It is proven on real calls and is still
         the better route when the phone IS at home: no forwarding, no browser,
         no Google in the path. -->
    <!-- Switched to googlevoice 2026-08-23. Phone Link only reaches this PC
         over Bluetooth, so it screened calls only while the phone was within
         ~10m of the desk - exactly when Layth could have answered it himself.
         `phonelink` still works and is still the better route when the phone
         IS at home. -->
    <add key="CallTransport" value="googlevoice" />

    <!-- The floating call card: who is calling, what stage the call is at, the
         last thing said, and a Hang up button. On the Google Voice path the
         browser is HEADLESS, so without this a screened call is completely
         invisible — something answers the phone, talks to a stranger, and the
         only evidence is a console line. Off is for headless machines. -->
    <add key="CallWidget" value="true" />

    <!-- Speaker volume held for the duration of a screened call, then restored.
         Not cosmetic: the INBOUND leg is a WASAPI loopback on the speakers, so
         how loudly Windows renders the caller is literally the microphone
         level. Measured 2026-08-22 with the volume at 23%, the caller arrived
         at 0.0005 against a 0.05 target and the bridge's 8x gain ceiling could
         not close a gap needing ~100x — audible, but repeatedly misheard.

         Only ever RAISES, never lowers. 0 disables it entirely.

         DISABLED by default since 2026-08-22: CallCableIn is now a virtual
         cable, so there is no audible endpoint left in the signal chain and the
         volume slider stopped being load-bearing. Left in place, and only
         meaningful, for a CallCableIn pointing at a REAL endpoint. -->
    <add key="CallSpeakerVolume" value="0" />

    <!-- Chromium that hosts the Google Voice client. Empty auto-detects Chrome
         then Edge. Chrome is preferred only because it is what the headless
         audio behaviour was actually measured against. -->
    <add key="CallGvChromePath" value="" />

    <!-- Its OWN profile directory, never the everyday browser profile: sharing
         one would mean automation driving the browser you read email in, and a
         stray tab or a restart taking screening down with it. Empty means
         %APPDATA%\LAITH\gvprofile.

         Sign in there ONCE with a visible window (GvProbe setup) — Google
         refuses sign-in from automated browsers — and set the Google Voice
         audio devices in that same visit, including pinning RINGING to the real
         speakers so the ringtone is not rendered into the virtual cable. -->
    <add key="CallGvProfileDir" value="" />

    <!-- Headless really is safe here, contrary to the usual warning: measured
         2026-08-21, Chromium's new headless mode produced genuine WASAPI render and capture
         sessions on the DEFAULT endpoints against a headed control run, so
         CallAudioRouter redirects it unchanged. Set false to run the browser
         windowed-but-off-screen if something ever needs watching. -->
    <add key="CallGvHeadless" value="true" />

    <!-- DevTools port, bound to 127.0.0.1 only. It can drive a signed-in Google
         session, so it must never be reachable from off this machine. -->
    <add key="CallGvDebugPort" value="9333" />

    <!-- How long to wait for the browser to come up and show a Voice page. A
         cold profile is much slower than later runs. -->
    <add key="CallGvAttachTimeoutSeconds" value="30" />

    <!-- How long to wait for the Google Voice app to finish BOOTING after
         the page loads. Being on the right URL is not the same as being able
         to receive a call: measured 2026-08-22, a page navigated to Voice
         logged the correct URL and still rang through to voicemail, because
         the Polymer shell had not come up and the client had not registered.
         Readiness is the presence of the "Call panel" element. -->
    <add key="CallGvReadyTimeoutSeconds" value="45" />

    <!-- Folder to record what the model ACTUALLY HEARS from the caller,
         one WAV per call, 16 kHz mono - the exact bytes handed to Gemini,
         after resampling and gain. Empty = off.

         Exists because levels and transcripts have both misled: a healthy
         0.0456 inbound level still produced a turn transcribed as non-Latin
         script from a caller speaking English, and no number in a log says
         what audio SOUNDS like. Turn it on, take one call, listen.

         Leave it EMPTY in normal use: it records strangers on the phone. -->
    <add key="CallRecordInbound" value="" />

    <!-- ===== Call audio routing (Phase 1) =====

         Two directions, one virtual device installed. Only the WINDOWS
         COMMUNICATIONS ROLE is moved onto these while a call is live; the
         console and multimedia roles stay on the real speakers, so music and
         L.A.I.T.H.'s normal voice are untouched and `switch_audio_output` keeps
         working. The originals are written to %APPDATA%\LAITH\callaudio.json
         before the switch and put back afterwards.

         Names are matched against the Windows device list — exactly first, then
         as an unambiguous substring. An ambiguous name is REFUSED rather than
         guessed, because this machine also has Voicemod and two Steam virtual
         devices and routing a call into the wrong one is silent. Run
         `CallAudioProbe.exe devices` to see every endpoint and its state. -->

    <!-- AI -> caller. The assistant's voice is rendered here; VB-CABLE presents
         it back to Phone Link as CallCableMic. Free single VB-CABLE from
         vb-audio.com/Cable, which installs exactly these two endpoints. -->
    <!-- FULL device names, not fragments. Adding Hi-Fi Cable on 2026-08-22
         made "CABLE Input" and "CABLE Output" AMBIGUOUS - they are
         substrings of "Hi-Fi Cable Input" and "Hi-Fi Cable Output" - and
         AudioController rightly refuses to guess between two matches, so
         every arm failed the outbound preflight until these were spelled
         out. Any new virtual cable can collide the same way. -->
    <add key="CallCableOut" value="CABLE Input (VB-Audio Virtual Cable)" />

    <!-- ...and the capture side of that same cable, which becomes the
         communications-role RECORDING default during a call — i.e. what Phone
         Link uses as the microphone. -->
    <add key="CallCableMic" value="CABLE Output (VB-Audio Virtual Cable)" />

    <!-- caller -> AI. A render endpoint that becomes the communications-role
         PLAYBACK default during a call and is then WASAPI loopback-captured.

         This was the monitor's audio endpoint (LS32FG51x), chosen because
         nothing else renders to it. That lasted until 2026-08-16, when every
         NVIDIA endpoint on this machine read NotPresent — the monitor had been
         Active hours earlier. An endpoint that comes and goes with a display
         cable is a poor foundation for a feature that has to work when Layth is
         not at the desk, and the preflight would have refused every time.

         The built-in speakers cannot be unplugged. The cost is that a loopback
         there hears everything, not just the call, so the call session pauses
         media (MediaController) and holds PresenceGate.MuteFor for its
         duration — otherwise a notification chime reaches the caller, and worse,
         L.A.I.T.H.'s own announcements would be fed back to Gemini as though the
         caller had said them.

         The upside is real: Layth hears the screened call live, which the silent
         monitor endpoint could never have offered.

         SUPERSEDED 2026-08-22 by a second virtual cable, which is what this
         setting wanted all along. Hi-Fi Cable (VB-Audio, a free direct download,
         unlike VB-CABLE A+B which is sold through their shop) gives an endpoint
         that nothing else renders to AND that can never read NotPresent, because
         a virtual device has no display cable to be unplugged. The monitor
         endpoint had the first property and not the second; the speakers had the
         second and not the first.

         What that fixes, all of which was real and reported:
           * the call is no longer AUDIBLE in the room
           * a video playing on the speakers can no longer bleed into the line
           * the level no longer depends on the volume slider, which sat at 23%
             and left the caller at 0.0005 against a 0.05 target

         The lost upside is genuine: Layth can no longer hear a screened call
         live. He asked for exactly that - hearing every caller was the
         complaint, not the feature. GV's RINGING output stays pinned to the real
         speakers, so an incoming call is still audible.

         Set this back to the speakers to hear calls live again, and re-enable
         CallSpeakerVolume if you do. -->
    <add key="CallCableIn" value="Hi-Fi Cable Input (VB-Audio Hi-Fi Cable)" />

    <!-- Which audio roles a call moves.

         true (default) moves Console, Multimedia AND Communications onto the
         call path for the call's duration. The plan said Communications alone,
         so that music and L.A.I.T.H.'s own voice never left the real devices —
         right in principle, wrong in fact. Measured 2026-08-17 during a real
         call with `AudioSessions.exe`: Phone Link's call audio does not run in
         PhoneExperienceHost at all. It belongs to `svchost` (the Bluetooth
         audio-gateway service), which opened the laptop's Microphone Array while
         the Communications recording default was CABLE Output — it ignores the
         role and takes the plain default. The caller heard silence.

         The cost is that the machine's default microphone IS the cable while a
         call is live, so the wake word is deaf until it ends. The call already
         pauses media and mutes announcements for the same reason, and every role
         is saved before the switch and put back after — including from disk, if
         the process dies mid-call.

         false reverts to Communications-only, for a machine whose telephony
         stack honours the role. -->
    <add key="CallMoveAllRoles" value="true" />

    <!-- Signal-test both legs before arming: play a tone into each and confirm
         it arrives. A driver being installed is not the same question as sound
         reaching the other end of a cable, and every way this fails sounds
         identical from the outside — the caller hears nothing. false skips
         straight to a presence check, which is faster and proves less. -->
    <add key="CallPreflightTone" value="true" />

    <!-- How often the ring watcher looks for the incoming-call toast, in
         milliseconds, WHILE ARMED — it does nothing at all while disarmed.

         Two seconds and not less: reading the notification tree costs ~350ms
         however it is asked (measured — the toast is a UIA-only window, so the
         cheap Win32 route that the call window uses is not available), and a
         phone rings for about twenty seconds, so this still gets ten looks. Most
         calls are caught faster than that anyway — a window-opened event wakes
         the watcher immediately, and this poll is what covers the case that
         event cannot see, a toast stacking into an already-open window. -->
    <add key="CallScreeningPollMs" value="2000" />

  </appSettings>
