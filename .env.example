# Copy to .env — docker compose reads it automatically.
#
# CONTACTS_FILE is the host path to the JSON file mapping contact names to phone
# numbers. The STT container mounts it read-only and builds its decoder boosting
# tree from the names; without it, contact-name recall drops from 75% to 41.7%.
#
# The app reads the same file through the CONTACTS_PATH *user environment
# variable*, which compose does not set — keep the two in step. The names differ
# on purpose: compose prefers a shell variable over this file, so naming this one
# CONTACTS_PATH would let a stale user environment variable silently override it.
CONTACTS_FILE=C:\Users\you\path\to\contacts.json
